auto dijkstra=[&](ll v){
    vector<ll> dist(n,INF);dist[v]=0;
    priority_min<array<ll,2>> hq;hq.push({0,v});
    while(hq.size()>0){
      auto [c,now]=hq.top();hq.pop();
      if(dist[now]<c){
        continue;
      }
      for(auto [nex,cost]:con[now]){
        if(chmin(dist[nex],dist[now]+cost)){
          hq.push({dist[nex],nex});
        }
      }
    }
    return dist;
  };
