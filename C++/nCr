// --- 組み合わせライブラリ (nCr / nHr) ---
vc<mint> kai, inv;

void make_kai(int n) {
    kai.assign(n + 10, 1);
    inv.assign(n + 10, 1);
    rep(i, 1, n + 10) kai[i] = kai[i - 1] * i;
    inv[n + 9] = kai[n + 9].inv();
    rrep(i, 0, n + 9) inv[i] = inv[i + 1] * (i + 1);
}

// nCr (nHr は combi(n + r - 1, r) を呼ぶ)
mint combi(ll n, ll r) {
    if (n == 0 && r == 0) return 1;
    if (n < r || r < 0 || n < 0) return 0;
    return kai[n] * inv[r] * inv[n - r];
}
