template<class C, class T> ll lower_idx(const C& c, const T& x) { return lower_bound(c.begin(), c.end(), x) - c.begin(); }
template<class C, class T> ll upper_idx(const C& c, const T& x) { return upper_bound(c.begin(), c.end(), x) - c.begin(); }
template<class C, class T> ll lower_idx0(const C& v, const T& x) { return lower_bound(v.begin(), v.end(), x, [](const auto& a, const auto& val) { return a[0] < val; }) - v.begin(); }
template<class C, class T> ll upper_idx0(const C& v, const T& x) { return upper_bound(v.begin(), v.end(), x, [](const auto& val, const auto& a) { return val < a[0]; }) - v.begin(); }

