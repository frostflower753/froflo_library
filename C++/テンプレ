constexpr ll ipow(ll b, ll e) { ll r = 1; while (e > 0) { if (e & 1) r = (ll)((__int128)r * b); b = (ll)((__int128)b * b); e >>= 1; } return r; }
constexpr ll modpow(ll b, ll e, ll m) { b %= m; if (b < 0) b += m; ll r = 1; while (e > 0) { if (e & 1) r = (__int128)r * b % m; b = (__int128)b * b % m; e >>= 1; } return r; }
constexpr ll modinv(ll b, ll m) { return modpow(b, m - 2, m); }

template<typename T> T GCD(const vector<T>& v) { T r = 0; for (auto x : v) r = std::gcd(r, x); return r; }
template<class T, class... Args> auto GCD(T a, Args... args) { if constexpr (sizeof...(args) == 0) return a; else return std::gcd(a, GCD(args...)); }
template<typename T> T LCM(const vector<T>& v) { T r = 1; for (auto x : v) r = std::lcm(r, x); return r; }
template<class T, class... Args> auto LCM(T a, Args... args) { if constexpr (sizeof...(args) == 0) return a; else return std::lcm(a, LCM(args...)); }

