--------------------------------------------------------------------------------
1. 基本入力・型定義
--------------------------------------------------------------------------------
LL(a, b, ...);        // ll a, b; scan(a, b); と同等 (複数入力対応)
STR(s, t, ...);       // str s, t; scan(s, t); と同等

vc<T>                 // vector<T> の別名
vvc<T>                // vector<vector<T>> の別名
pll / tll             // pair<ll, ll> / tuple<ll, ll, ll>
mint                  // modint998244353

--------------------------------------------------------------------------------
2. ループマクロ (rep / rrep)
--------------------------------------------------------------------------------
rep(n)                // for(ll i = 0; i < n; i++)
rep(i, n)             // for(ll i = 0; i < n; i++)
rep(i, l, r)          // for(ll i = l; i < r; i++)
rep(i, l, r, s)       // for(ll i = l; i < r; i += s)

rrep(n)               // for(ll i = n - 1; i >= 0; i--)
rrep(i, n)            // for(ll i = n - 1; i >= 0; i--)
rrep(i, l, r)         // for(ll i = r - 1; i >= l; i--)
rrep(i, l, r, s)      // for(ll i = r - 1; i >= l; i -= s)

ALL(x) / rALL(x)      // (x).begin(), (x).end() / (x).rbegin(), (x).rend()

--------------------------------------------------------------------------------
3. 入出力 & デバッグ
--------------------------------------------------------------------------------
cin >> vec;           // vector の全要素を一括入力
cout << vec;          // vector の全要素をスペース区切りで一括出力
cout << mint_val;     // mint.val() を自動出力

print(a, b, ...);     // 可変長引数をスペース区切りで出力 ＋ 改行
Yes / No              // "Yes\n" / "No\n" を出力
YES(cond);            // cond ? "Yes" : "No" を出力
CJ(vec, sep);         // cout_join: vector の要素を指定区切り文字で結合出力

dmp(x, vec);          // デバッグ用出力 (ローカル環境 #ifdef LOCAL のみ動作)

--------------------------------------------------------------------------------
4. 便利関数
--------------------------------------------------------------------------------
[型変換]
si(c), si(s)          // char / string -> int
cll(c), cll(s)        // char / string -> ll
sc(n)                 // 1桁の数値(ll) -> char
ss(n), ss(c)          // ll / char -> string

[更新・判定]
chmax(a, b)           // a < b なら a = b に更新して true
chmin(a, b)           // a > b なら a = b に更新して true
ifel(cond, t, f)      // cond ? t : f (三項演算子の関数化)
bit(n, i)             // n の i ビット目が 1 か判定 (bool)

[統計・演算 (vector または可変長引数に対応)]
MAX(v) / MAX(a, b, c) // 最大値取得
MIN(v) / MIN(a, b, c) // 最小値取得
SUM(v) / SUM(a, b, c) // 合計値取得
GCD(v) / GCD(a, b, c) // 最大公約数
LCM(v) / LCM(a, b, c) // 最小公倍数

[二分探索 (0-indexed のインデックスを直返し)]
lower_idx(v, x)       // v における x 以上の初出インデックス
upper_idx(v, x)       // v における x 超過の初出インデックス
lower_idx0(v2d, x)    // 2次元配列 v2d[*][0] に対する lower_bound インデックス

[多次元 vector 構築 & 便利処理]
vvvc(d1, d2, d3, val) // 任意次元の vector を初期値 val で構築 (例: auto dp = vvvc(N, M, K, 0LL);)
mkuni(v)              // 昇順ソート ＋ 重複削除 (座標圧縮の下準備)
py_at(v, i)           // Python風の負のインデックス対応参照 (例: py_at(v, -1) で末尾参照)

--------------------------------------------------------------------------------
5. 高度データ構造
--------------------------------------------------------------------------------
■ SortedList<T> (順位付き自動ソート集合 / pb_ds)
  常に昇順ソート状態を保持し、インデックスアクセスが可能な集合構造。
  - sl.insert(x)     : 要素 x を追加 O(log N)
  - sl.erase(x)      : 要素 x を 1 個削除 O(log N)
  - sl[k]            : 小さい方から k 番目 (0-indexed) の要素を取得 O(log N)
  - sl.index(x)      : x 未満の要素数（x の割り込みインデックス）を取得 O(log N)
  - sl.size()        : 要素数を取得 O(1)

■ TreapVector<T> (動的配列 / Implicit Treap)
  途中の挿入・削除・区間反転がすべて高速に行える特殊配列。
  - tv.insert(k, x)  : k 番目の位置に値 x を挿入 O(log N)
  - tv.erase(k)      : k 番目の要素を削除 O(log N)
  - tv.reverse(L, R) : 閉区間 [L, R] の要素を反転 O(log N)
  - tv[k]            : k 番目の要素を取得 O(log N)
  - tv.size()        : 要素数を取得 O(1)

