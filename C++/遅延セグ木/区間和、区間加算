// =========================================================
// ① 区間加算 × 区間和
// =========================================================
// 1. 要素の型 S と、区間の統合 op, 初期値 e
struct S {
    ll value;
    ll size;
};

S op(S a, S b) {
    return {a.value + b.value, a.size + b.size};
}

S e() {
    return {0, 0};
}

// 2. 更新操作の型 F と、操作の適用 mapping, 操作の合成 composition, 未操作の目印 id
using F = ll;
const F ID = 0; // 何も操作しない状態の目印（恒等写像）

S mapping(F f, S x) {
    if (f == ID) return x; // 更新命令がなければそのまま
    return {x.value + f * x.size, x.size}; // 区間長ぶん加算
}

F composition(F f, F g) {
    if (f == ID) return g; // 新しい命令がなければ古い命令 g のまま
    return f + g;          // 新しい命令がきたら加算を合成
}

F id() { return ID; }

