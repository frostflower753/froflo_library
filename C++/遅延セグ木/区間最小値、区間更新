// =========================================================
// ⑥ 区間更新 × 区間最小値
// =========================================================
// 1. 要素の型 S と、区間の統合 op, 初期値 e
using S = ll;

S op(S a, S b) {
    return min(a, b);
}

S e() {
    return INF; // 十分大きい値
}

// 2. 更新操作の型 F と、操作の適用 mapping, 操作の合成 composition, 未操作の目印 id
using F = ll;
const F ID = INF; // 未更新を表す目印

S mapping(F f, S x) {
    if (f == ID) return x; // 更新命令がなければそのまま
    return f;              // あれば f で上書き
}

F composition(F f, F g) {
    if (f == ID) return g; // 新しい命令がなければ古い命令 g のまま
    return f;              // 新しい命令がきたら上書き
}

F id() { return ID; }

/*
[操作例]
・初期化
  lazy_segtree<S, op, e, F, mapping, composition, id> seg(n); // 初期値 0

・区間 [l, r) の値をすべて x に更新
  seg.apply(l, r, x);

・区間 [l, r) の最小値を取得
  ll res = seg.prod(l, r);

・1点 p の現在の値を取得
  ll val = seg.get(p);
