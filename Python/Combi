# 階乗(kai)と階乗の逆元(inv)を作る前計算関数
def make_kai(n, MOD):
  kai = [1] * (n + 10)
  inv = [1] * (n + 10)
  for i in range(1, n + 10):
    kai[i] = (kai[i - 1] * i) % MOD 
  inv[n + 9] = pow(kai[n + 9], -1, MOD)
  for i in range(n + 8, -1, -1):
    inv[i] = (inv[i + 1] * (i + 1)) % MOD
  #2つ返ってくる
  return kai, inv
# nCr
#重複組合せは(n+r-1)C(r)をしよう！
def combi(n, r, kai, inv, MOD):
  if n < r or r < 0 or n < 0:
    return 0
  return (kai[n] * inv[r] % MOD) * inv[n - r] % MOD
