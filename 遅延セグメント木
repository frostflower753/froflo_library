seg_iv = [0, 1] # 最小値(min)なら [10**18, 1] 
lazy_iv = None
def op(x, y):          return [max(x[0], y[0]), x[1] + y[1]]
def mp(f, x):     return [f, x[1]] if f != lazy_iv else x
def cp(f, g): return f if f != lazy_iv else g

