def make_seg(x):
  seg=[seg_iv[:] for i in range(x*2)]
  for i in range(x-1,0,-1):
    seg[i][1]=seg[i*2][1]+seg[i*2+1][1]
  return seg
def make_lazy(x):
  lazy=[lazy_iv for i in range(x*2)]
  return lazy

def push(k):                                     #k：頂点番号
  if lazy[k]==lazy_iv:                           #何もなければ放置
    return                                      
  lazy[k*2]=cp(lazy[k], lazy[k*2])
  lazy[k*2+1]=cp(lazy[k], lazy[k*2+1])
  seg[k*2] = mp(lazy[k], seg[k*2]) 
  seg[k*2+1] = mp(lazy[k], seg[k*2+1])
  lazy[k] = lazy_iv                              #初期化

def update(a,b,v):                         #[a:b):更新したい範囲、v:更新する値、k:現在の頂点、[l:r):今見てる範囲
  l=a+x
  r=b+x
  for i in range(height,0,-1):
    parl=l//(2**i)
    parr=(r-1)//(2**i)
    if parl>0:
      push(parl)
    if parr>0:
      push(parr)
  l_co,r_co=l,r
  while l < r:
    if l%2==1:
      lazy[l]=cp(v,lazy[l])
      seg[l]=mp(v,seg[l])
      l+=1
    if r%2==1:
      r-=1
      lazy[r]=cp(v,lazy[r])
      seg[r]=mp(v,seg[r])
    l//=2
    r//=2
  while l_co > 1:
    l_co//=2
    seg[l_co] = mp(lazy[l_co], op(seg[l_co*2], seg[l_co*2+1]))
  r_co-=1
  while r_co > 1:
    r_co//=2
    seg[r_co] = mp(lazy[r_co], op(seg[r_co*2], seg[r_co*2+1]))

def query(a,b):                            #[a,b):集めたいデータ範囲、k:現在の頂点、[l:r):今見てる範囲
  l=a+x
  r=b+x
  for i in range(height,0,-1):
    parl=l//(2**i)
    parr=(r-1)//(2**i)
    if parl>0:
      push(parl)
    if parr>0:
      push(parr)
  resl=seg_iv[:]
  resr=seg_iv[:]
  while l < r:
    if l%2==1:
      resl=op(resl,seg[l])
      l+=1
    if r%2 == 1:
      r-=1
      resr=op(seg[r],resr)
    l//=2
    r//=2
  return op(resl,resr)

